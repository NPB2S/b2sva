  // Close mobile menu on route click
  document.querySelectorAll('#mobile-menu a, #mobile-menu button').forEach(item => {
    item.addEventListener('click', () => {
      if (mobileMenu) mobileMenu.classList.add('hidden');
    });
  });
}

